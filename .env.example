# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# Leave empty to run in demo mode with invented data.
DISCORD_TOKEN=

# Password for the "Pengaturan ruangan" panel. Leave empty to disable the panel.
ADMIN_PASSWORD=

# Port the server listens on.
PORT=8787
