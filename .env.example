# Copy to .env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token.
# Leave empty to run in demo mode with invented data.
DISCORD_TOKEN=

# Password for the "Pengaturan ruangan" panel. Leave empty to disable the panel.
ADMIN_PASSWORD=

# Port the server listens on.
PORT=8787

# Where visitors reach the site, without a trailing slash. Links the bot hands out in Discord lead here.
# Locally: http://localhost:8787   On the host: the public https address.
PUBLIC_URL=http://localhost:8787

# Member levels are read from MEE6's public leaderboard of each shown server. Set to off to never call it.
MEE6_LEVELS=on

# Optional: "Masuk dengan Discord" on the site. From the Developer Portal -> your app -> OAuth2.
# Also add <PUBLIC_URL>/api/auth/discord/callback under Redirects there. Leave empty to offer only
# the personal link from /karakter.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# testing sync repo
